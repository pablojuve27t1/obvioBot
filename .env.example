# Copiar este archivo como .env y completar con los valores reales:
#   cp .env.example .env
#   nano .env
#
# IMPORTANTE: el archivo .env NUNCA se sube a git (esta en .gitignore).
# La clave privada de la wallet no se comparte por chat ni por ningun otro
# medio - se escribe directo en el servidor con nano.

# --- Wallet / Polymarket ---
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_EOA=

# --- Credenciales de API de Polymarket (CLOB) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Configuracion del bot ---
INITIAL_CAPITAL=50.88
MAX_CONCURRENT=7
STOP_LOSS_DAILY_USD=5.0
STOP_LOSS_TOTAL_PCT=0.20

# --- Telegram (alertas del monitor de seguridad) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
